
# Create data for LM training. Requires ../knifer-data directory.

DATADIR=../knifer-data
TEST=$DATADIR/CC-MAIN-2024-18/000_00000.jsonl.zst
TESTEMPIRERAW=$DATADIR/test.empire.raw.txt
TRAIN1=$DATADIR/CC-MAIN-2024-18/000_00001.jsonl.zst
TRAIN2=$DATADIR/CC-MAIN-2024-18/000_00002.jsonl.zst
TRAIN3=$DATADIR/CC-MAIN-2024-18/000_00003.jsonl.zst
TRAIN4=$DATADIR/CC-MAIN-2024-18/000_00004.jsonl.zst
TRAINPILE=$DATADIR/pile-small/train.char.txt
TRAINZODIACRAW=$DATADIR/train.zodiac.raw.txt

rm -f $DATADIR/train.char.txt
touch train.char.txt

for i in $TRAIN1 $TRAIN2 $TRAIN3 $TRAIN4
do
  echo 'processing train set '$i
  zstd -d --stdout $i |
  python cleandata.py | 
  sed 's/./& /g' | sed 's/^/# /' | 
  sed 's/ *$/ #/' >> $DATADIR/train.char.txt
done

echo 'processing zodiac'

cat $TRAINZODIACRAW | 
tr 'A-Z' 'a-z' | tr -dc 'a-z\n' | sed 's/./& /g' |
awk 'NF>0' | sed 's/^/# /' |
sed 's/ *$/ #/' >> $DATADIR/train.char.txt

cat $TRAINPILE >>$DATADIR/train.char.txt

echo 'processing test set '$TEST

zstd -d --stdout $TEST |
head -100 |
python cleandata.py |
sed 's/./& /g' | sed 's/^/# /' | 
sed 's/ *$/ #/' > $DATADIR/test.char.txt

echo 'processing test set'$TESTEMPIRE

cat $TESTEMPIRERAW |
sed 's/^/# /' | sed 's/ *$/ #/' |
grep -v '# #' > $DATADIR/test.empire.txt

