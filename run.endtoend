
# This script creates train/test plaintext data for English, builds
# an LSTM character-based LM, and deciphers a ciphertext with it.
#
# Data resides outside this GitHub (../knifer-data), so currently
# this script comments out the make-data part, as it's already made.

echo '========================'
echo '=== Making data'
echo '========================'

#./makedata-small

echo '========================'
echo '=== Building LM (5 min)'
echo '========================'

time python lstm8.py \
  --train train-data/train.small.char.txt --test test-data/test.small.char.txt \
  --epochs 5 \
  --emb 512 --hidden 512 --layers 3 --block 512 --bsz 64 \
  --lr 2e-3 --wd 0.01 --dropin 0.2 --droph 0.2 --dropout 0.2 \
  --save charsmall.pt # --save_dir ckpts.small --save_every 2 --full_ckpt

echo '========================'
echo '=== Deciphering (5 min)'
echo '========================'

echo 'ciphertext =' `cat test-data/test.ct.goodnews.txt`

time python beam_subst24.py charsmall.pt test-data/test.ct.goodnews.txt \
  --beam 5000 --nbest 20 --incremental --restcost 2 --dtype bf16

echo '========================'
echo '=== Scoring     (5 sec)'
echo '========================'

time python score5_lstm.py charsmall.pt test-data/test.pt.goodnews.txt

