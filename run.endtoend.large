
# This script creates train/test plaintext data for English, builds
# an LSTM character-based LM, and deciphers a ciphertext with it.
#
# Data resides outside this GitHub (../knifer-data), so currently
# this script comments out the make-data part, as it's already made.

echo '========================'
echo '=== Making data'
echo '========================'

./makedata-large

echo '========================'
echo '=== Building LM '
echo '========================'

time python lstm6.py \
  --train ../knifer-data/train.char.txt --test ../knifer-data/test.char.txt \
  --epochs 15 \
  --emb 512 --hidden 512 --layers 3 --block 512 --bsz 64 \
  --lr 2e-3 --wd 0.01 --dropin 0.2 --droph 0.2 --dropout 0.2 \
  --save charlarge6b.pt  --save_dir ckpts6b --save_every 3 --full_ckpt

mv char_lstm_last.pt charlarge6b_last.pt

echo '========================'
echo '=== Deciphering '
echo '========================'

echo 'ciphertext =' `cat test-data/test.ct.goodnews.txt`

time python beam_subst17.py charlarge6b.pt test-data/test.ct.goodnews.txt \
  --beam 20000 --nbest 20 \
  --topk 26 --alpha 0.00 --gumbel 0.05 --prior_w 0.0 --refine 1 \
  --dtype bf16

echo '========================'
echo '=== Scoring'
echo '========================'

echo '=== scoring goodnews'
echo '=== with small LM =================='
time python score5_lstm.py charsmall.pt test-data/test.pt.goodnews.txt
echo '=== with large LM, 5it =================='
time python score5_lstm.py charlarge.pt test-data/test.pt.goodnews.txt
echo '=== with large LM, 40it =================='
time python score5_lstm.py charlarge2.pt test-data/test.pt.goodnews.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge3.pt test-data/test.pt.goodnews.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge6b.pt test-data/test.pt.goodnews.txt

echo '=== scoring empire'
echo '=== with small LM =================='
time python score5_lstm.py charsmall.pt ../knifer-data/test.empire.txt
echo '=== with large LM, 5it =================='
time python score5_lstm.py charlarge.pt ../knifer-data/test.empire.txt
echo '=== with large LM, 40it =================='
time python score5_lstm.py charlarge2.pt ../knifer-data/test.empire.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge3.pt ../knifer-data/test.empire.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge6b.pt ../knifer-data/test.empire.txt

echo '=== scoring char'
echo '=== with small LM =================='
time python score5_lstm.py charsmall.pt ../knifer-data/test.char.txt
echo '=== with large LM, 5it =================='
time python score5_lstm.py charlarge.pt ../knifer-data/test.char.txt
echo '=== with large LM, 40it =================='
time python score5_lstm.py charlarge2.pt ../knifer-data/test.char.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge3.pt ../knifer-data/test.char.txt
echo '=== with huge LM, 1it =================='
time python score5_lstm.py charlarge6b.pt ../knifer-data/test.char.txt


